# macOS
.DS_Store

# 会话临时文件（dsh 约定：只忽略 tmp/ 与 plans/，不忽略整个 .dsh/）
.dsh/tmp/
.dsh/plans/

# 工具生成物：由工具重新生成，不入库
#
# build/  tools/split-index.mjs 的旧产物（整段搬运版，保留给 verify.mjs 做文本比对）
# dist/  tools/build.mjs 的产物（分层版的部署形态）
#
# 注意 src/ 不在此列——它是 tools/split.mjs 生成的，但属于要入库的源码：
# 改逻辑应当改 src/，index.html 只是尚未退役的旧入口。
build/
dist/
